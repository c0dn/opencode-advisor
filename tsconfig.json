{
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "noEmit": true,
    "skipLibCheck": true,
    "strict": true,
    "target": "ESNext",
    "types": [
      "bun"
    ],
    "jsx": "preserve",
    "jsxImportSource": "@opentui/solid"
  },
  "include": [
    "index.ts",
    "tui.ts",
    "src/*.ts",
    "src/*.tsx",
    "test/*.ts"
  ]
}
